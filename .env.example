# Example environment variables for rfu-parser
# Copy this to `.env` and fill with real secrets (DO NOT commit real keys).
ADMIN_PASSWORD=change-me
SECRET_KEY=replace-with-a-strong-secret
PORT=5000

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: other service keys
# SENTRY_DSN=your-sentry-dsn# RFU Hub Environment Variables Example
